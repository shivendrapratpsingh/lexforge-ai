# LexForge AI — environment template.
# Copy this file to `.env.local` (for `npm run dev`) and `.env` (for Prisma CLI),
# then fill in the values below. None of the .env* files are committed —
# they're listed in .gitignore.

# ── REQUIRED ────────────────────────────────────────────────────────────

# Postgres connection string. Free tier available at https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Random 32+ char secret used by next-auth.
# Generate with:   openssl rand -base64 32
AUTH_SECRET="your-random-32-char-secret-here"

# Public URL of the app. http://localhost:3000 in dev, your Vercel URL in prod.
NEXTAUTH_URL="http://localhost:3000"

# ── AI PROVIDER ─────────────────────────────────────────────────────────
#
# At least ONE of the keys below must be set or no document can be drafted.
#
# The chain is tried in order and a provider with no key is skipped, so
# you can add Gemini without removing Groq and the app switches over on
# its own — no deploy, no code change.
#
# Why Gemini leads: Groq's free plan allows 8,000 tokens a minute, and
# this app's system prompt is 5,300-6,800 of them. A Pro draft in Hindi
# left NEGATIVE headroom, so every model was skipped and the user
# silently received a template of their own form fields. Groq's paid
# tier would fix it but signups are closed. Gemini's paid Tier 1 allows
# 250,000 a minute, which takes a Pro draft from ~508 words to ~5,300.
AI_PROVIDERS="gemini,groq"

# Google Gemini. Key from https://aistudio.google.com  → "Get API key".
# TURN ON BILLING. The free tier may train on what you send it, which
# would breach the data-protection undertaking given to colleges.
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API key — now the RESERVE provider. Free tier at
# https://console.groq.com. Safe to keep: it is only called when Gemini
# fails, and its 8,000 TPM ceiling then applies just to that attempt.
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Gemini's tokens-per-minute ceiling. Defaults to 250,000, which is paid
# Tier 1. On the FREE tier the real figure is lower and Google does not
# publish it — read it per-project at aistudio.google.com and set it
# here, or the clamp will size a request that then 429s.
# GEMINI_TPM="250000"

# Overrides the per-1K-token cost used by the admin cost model, in paise.
# Default 16, blended for gemini-3.8-flash. See lib/usage.js.
# RATE_AI_PER_KTOKEN="16"

# ── OPTIONAL ────────────────────────────────────────────────────────────

# next-auth v5 sometimes also reads AUTH_URL — leave it equal to NEXTAUTH_URL.
# AUTH_URL="http://localhost:3000"

# ── ADMIN ACCESS ────────────────────────────────────────────────────────
#
# The platform admin is whoever ADMIN_EMAIL names. It is NOT hard-coded
# anywhere and has no default: this repository is public, and an admin
# address written into it tells a reader exactly which account to attack.
# Unset means nobody is admin, which fails closed — a missing variable
# locks the console rather than opening it.
#
# ADMIN_EMAIL="you@example.com"
#
# Register or log in with that address and the /admin route and Admin
# Console appear in the sidebar.
#
# Pro tier is granted in any of these ways:
#   1. Being ADMIN_EMAIL (always Pro).
#   2. Admin Console -> Users -> Upgrade (sets User.tier = 'pro' in the DB).
#   3. Admin Console -> Global Pro Promotion (everyone Pro for a window).
#   4. Admin Console -> Individual Pro Grants (per-email Pro for a window).
#   5. Admin Console -> System Settings -> Pro Enforcement OFF
#      (everyone gets Pro features for free).
#   6. Admin Console -> Institutions -> Upload student list (a college's
#      whole class, from one spreadsheet).
#   7. Admin Console -> the early users (grandfathered, permanent).
#   8. A paid subscription (see PAYMENTS below).

# ── PAYMENTS (Razorpay) ─────────────────────────────────────────────────
#
# Leave these blank and the app stays invite-only: /upgrade shows the
# "email the admin" path instead of a Pay button, and no payment route
# will do anything. Nothing breaks without them.
#
# Get them from dashboard.razorpay.com -> Settings -> API Keys, after
# completing KYC (PAN, GST or proprietorship proof, bank account).
# Test keys start rzp_test_ and move no real money — start there.
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_key_secret"
#
# The webhook is what credits a user who closed the tab mid-payment, so
# it matters more than it looks. Razorpay Dashboard -> Settings ->
# Webhooks -> Add: URL https://<your-domain>/api/billing/webhook,
# events payment.captured, payment.failed, refund.processed. The secret
# you type there is the value below.
# RAZORPAY_WEBHOOK_SECRET="whatever_you_typed_in_the_dashboard"

# ── PRICING ─────────────────────────────────────────────────────────────
#
# All in paise (100 paise = ₹1), so no floating-point rupees. Change
# them here rather than in code — a price is a business decision, not a
# deploy, and the admin cost panel is where the real per-user figure
# comes from.
#
# One price for anyone buying directly: a lawyer and a law student pay
# the same. A student whose college has a plan pays nothing at all.
# PRICE_MONTHLY_PAISE="42000"     # ₹420 / 30 days
# PRICE_YEARLY_PAISE="403200"     # ₹4,032 / 365 days — 20% off twelve months
#
# What a college pays per student. Per seat rather than a flat licence,
# so a college with forty active students is not billed like one with
# four hundred.
# PRICE_SEAT_MONTHLY_PAISE="42000"   # ₹420 per student per month
# PRICE_SEAT_YEARLY_PAISE="352800"   # ₹3,528 per student per year — 30% off

# ── COST TRACKING ───────────────────────────────────────────────────────
#
# What each upstream call is assumed to cost, used by the admin cost
# panel. Defaults are estimates; replace them when the real invoices
# arrive so the pricing figure stops being a guess.
# RATE_GROQ_PER_KTOKEN="3"       # paise per 1,000 tokens
# RATE_KANOON_SEARCH="50"        # paise per search — ₹0.50, published rate
# RATE_KANOON_DOC="20"           # paise per judgment — ₹0.20 for /doc/
# RATE_ECOURTS_CASE="200"        # paise per CNR lookup
#
# What the platform costs every month regardless of usage — Vercel Pro
# plus the domain. Without it the cost panel reports a per-user figure
# that ignores every bill you actually pay.
# RATE_FIXED_MONTHLY_PAISE="185000"   # Rs 1,850

# ── INVOICING (institutions) ────────────────────────────────────────────
#
# What appears on an invoice sent to a college. Leave GSTIN blank until
# the registration actually exists: without it the app issues a PROFORMA
# invoice, which is the correct document for an unregistered seller,
# charges no tax, and says so on its face. Charging GST without a
# registration is not a paperwork slip — it is collecting a tax that
# cannot be remitted.
# These also fill the Terms, Privacy, Refund and Contact pages, so a
# payment gateway sees one consistent identity across the whole site.
# SELLER_ADDRESS is REQUIRED before Razorpay will activate an account —
# until it is set, /contact says so rather than printing a fake address.
# SELLER_NAME="LexForge AI"
# SELLER_LEGAL_NAME="Shivendra Pratap Singh (Proprietor)"
# SELLER_ADDRESS uses real line breaks in the Vercel value box.
# In this file it is shown on one line for that reason.
# SELLER_ADDRESS="2nd Floor, 14 MG Road, Bengaluru 560001"
# SELLER_CITY="Bengaluru"
# SELLER_STATE="Karnataka"
# SELLER_EMAIL="billing@yourdomain.in"
# SELLER_PHONE="+91 ..."
# SELLER_PAN="ABCDE1234F"
# The Udyam number. Printed on the letterhead and cited in clause 1 of the
# GST non-registration declaration at /admin/papers/gst-declaration.
# SELLER_UDYAM="UDYAM-KR-00-0000000"
# SELLER_GSTIN=""                # set this and invoices become tax invoices
# GST_PERCENT="18"
#
# Shown as the payment instructions on the invoice.
# SELLER_BANK_NAME=""
# SELLER_BANK_ACCOUNT=""
# SELLER_BANK_IFSC=""
# SELLER_UPI=""

# ── DATA PROTECTION ─────────────────────────────────────────────────────
#
# The DPDP Act 2023 requires a named contact for data complaints. Falls
# back to SELLER_EMAIL when unset.
# GRIEVANCE_OFFICER_NAME=""
# GRIEVANCE_OFFICER_EMAIL=""
#
# Used in page metadata and canonical links.
# NEXT_PUBLIC_SITE_URL="https://lexforge-ai.vercel.app"
