{
  "name": "lexforge-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "icons": "node scripts/build-icons.mjs",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "verify": "npm run verify:models && npm run verify:robots && npm run verify:mail && npm run verify:dates && npm run verify:pricing && npm run verify:billing && npm run verify:institutions && npm run verify:expiry && npm run verify:college && npm run verify:invoicing && npm run verify:study && npm run verify:digest && npm run verify:assistant && npm run verify:sources",
    "verify:models": "dotenv -e .env.local -- node scripts/verify-models.mjs",
    "verify:billing": "node scripts/verify-billing.mjs",
    "verify:institutions": "dotenv -e .env.local -- node scripts/verify-institutions.mjs",
    "verify:expiry": "dotenv -e .env.local -- node scripts/verify-expiry.mjs",
    "verify:college": "dotenv -e .env.local -- node scripts/verify-college.mjs",
    "verify:invoicing": "dotenv -e .env.local -- node scripts/verify-invoicing.mjs",
    "verify:robots": "node scripts/verify-robots.mjs",
    "verify:sources": "dotenv -e .env.local -- node scripts/verify-legal-sources.mjs",
    "verify:mail": "node scripts/verify-mail.mjs",
    "verify:capacity": "dotenv -e .env.local -- node scripts/verify-capacity.mjs",
    "verify:database": "dotenv -e .env.local -- node scripts/verify-database.mjs",
    "verify:digest": "dotenv -e .env.local -- node scripts/verify-digest.mjs",
    "verify:study": "dotenv -e .env.local -- node scripts/verify-study.mjs",
    "verify:dates": "node scripts/verify-dates.mjs",
    "verify:assistant": "dotenv -e .env.local -- node scripts/verify-assistant.mjs",
    "verify:pricing": "node scripts/verify-pricing.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^8.5.0",
    "groq-sdk": "^0.5.0",
    "jspdf": "^2.5.1",
    "next": "^16.2.4",
    "next-auth": "^5.0.0-beta.25",
    "next-intl": "^4.3.4",
    "nodemailer": "^7.0.13",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.1",
    "eslint-config-next": "^16.2.4",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
