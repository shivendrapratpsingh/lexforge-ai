generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  name             String?
  email            String      @unique
  password         String?
  tier             String      @default("free")
  suspended        Boolean     @default(false)
  // Account recovery by security question, replacing emailed reset links.
  // The old resetToken / resetTokenExpiry columns are gone: a reset token
  // stored in the clear IS the credential, so anyone who could read the
  // table could take over any account with a reset pending. Nothing
  // replayable is stored now.
  // Only a bcrypt hash of the answer is ever stored — the answer is a
  // permanent credential (it cannot be rotated the way a 60-minute token
  // can), so it is protected exactly like a password. The attempt counter
  // and lockout exist because a nickname has little entropy and would
  // otherwise be trivially brute-forceable.
  // ── Single device ────────────────────────────────────────────
  // Sessions are JWTs, which are stateless by design — a token stays
  // valid wherever it is copied and there is no server-side list of
  // logins to revoke. So the token carries this number and the server
  // holds the truth: signing in anywhere bumps it, and every older
  // token stops matching on its next check.
  sessionVersion      Int       @default(0)
  // Set when a login supersedes another, so the device being pushed out
  // can say why rather than silently returning to the sign-in page.
  supersededAt        DateTime?

  // ── Bulk-created accounts ────────────────────────────────────
  // A student imported from a college's spreadsheet has a password the
  // college chose and no security question. Both are fixed on first
  // login before they reach the app: they set their own password, so
  // the one in the spreadsheet stops working, and a security question,
  // so they are never locked out the way an account with neither is.
  mustOnboard         Boolean   @default(false)

  securityQuestion    String?
  securityAnswerHash  String?
  securityAttempts    Int       @default(0)
  securityLockedUntil DateTime?
  passwordChangedAt   DateTime?

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  clients          Client[]
  courtDates       CourtDate[]
  drafts           Draft[]
  pushSubs         PushSubscription[]
  trackedCases     TrackedCase[]

  // Institutional membership. Set on signup when the email domain matches.
  institutionId    String?
  institution      Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  role             String       @default("student")  // student | faculty | staff
  batch            String?
  grandfathered    Boolean      @default(false)
  apiUsage         ApiUsage[]
  subscription     Subscription?

  @@index([institutionId])
}

// A browser/device push endpoint for the daily digest. One user can have
// several (phone, laptop, tablet), so the daily job de-duplicates by user
// and sends to every live endpoint. Endpoints that return 404/410 are
// pruned automatically — that is how a push service reports an uninstall.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  // Which digests this device wants. Stored as a comma-separated list so
  // preferences can grow without another migration.
  topics    String   @default("dates,drafts,study")
  hour      Int      @default(8)     // local-ish hour for the digest (IST)
  failCount Int      @default(0)
  lastSentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Client {
  id            String             @id @default(cuid())
  userId        String
  name          String
  fatherName    String?
  age           String?
  gender        String?
  phone         String?
  email         String?
  address       String?
  city          String?
  district      String?
  state         String?            @default("Uttar Pradesh")
  pincode       String?
  aadhaarNumber String?
  photo         String?
  tags          String?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments   ClientAttachment[]
  payments      ClientPayment[]
  courtDates    CourtDate[]
  drafts        Draft[]
}

model ClientAttachment {
  id        String   @id @default(cuid())
  clientId  String
  name      String
  label     String?
  docType   String   @default("other")
  mimeType  String   @default("application/octet-stream")
  size      Int?
  data      String
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientPayment {
  id          String   @id @default(cuid())
  clientId    String
  amount      Float
  date        DateTime
  mode        String   @default("cash")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Draft {
  id             String         @id @default(cuid())
  userId         String
  title          String
  content        String
  documentType   String
  status         String         @default("draft")
  templateData   Json?
  caseLaws       Json?
  legalReasoning String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  court          String?
  intakeMethod   String?        @default("form")
  language       String?        @default("english")
  sourceText     String?
  caseStatus     String?        @default("active")
  clientId       String?
  positivePoints String?
  amendmentNote  String?
  parentDraftId  String?
  courtDates     CourtDate[]
  client         Client?        @relation(fields: [clientId], references: [id])
  parentDraft    Draft?         @relation("DraftAmendments", fields: [parentDraftId], references: [id])
  amendments     Draft[]        @relation("DraftAmendments")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions       DraftVersion[]
}

model DraftVersion {
  id         String   @id @default(cuid())
  draftId    String
  version    Int
  content    String
  changeNote String?
  createdAt  DateTime @default(now())
  draft      Draft    @relation(fields: [draftId], references: [id], onDelete: Cascade)
}

model CourtDate {
  id         String   @id @default(cuid())
  userId     String
  draftId    String?
  clientId   String?
  title      String
  caseNumber String?
  date       DateTime
  type       String   @default("hearing")
  notes      String?
  completed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  client     Client?  @relation(fields: [clientId], references: [id])
  draft      Draft?   @relation(fields: [draftId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Admin-set free-Pro window for EVERYONE. Only the most recent row is treated
// as the active window; the rest are history. Pro access is granted while
// NOW is between startsAt and endsAt (inclusive).
model GlobalPromo {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Admin-set free-Pro grant for a specific email. The email does NOT need to
// belong to an existing user — if they sign up later, Pro kicks in during
// the window. Multiple non-overlapping rows per email are allowed.
model EmailPromo {
  id        String   @id @default(cuid())
  email     String
  startsAt  DateTime
  endsAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// ─────────────────────────────────────────────────────────────────
//  BriefJob — queued, multi-step brief generation that runs across
//  several Vercel function invocations.  Used when ENABLE_BRIEF_JOBS=1
//  to bypass the 60s Hobby-plan function cap for very long documents.
//  When upgrading to Vercel Pro you can simply unset the env var; the
//  app reverts to streaming briefs and nothing else needs to change.
//
//  State machine:
//    queued     → ready for the next worker tick
//    extracting → a worker is mid-extraction (transient lock)
//    reducing   → a worker is mid-final-synthesis
//    done       → result is final; brief field populated
//    failed     → error field populated; client surfaces error
// ─────────────────────────────────────────────────────────────────
model BriefJob {
  id           String   @id @default(cuid())
  userId       String
  state        String   @default("queued")
  // Source content + brief context
  sourceText   String
  court        String?
  language     String   @default("english")
  // Pipeline progress
  totalWindows Int      @default(0)
  doneWindows  Int      @default(0)
  ledger       String   @default("")    // accumulated fact-ledger from completed windows
  brief        String   @default("")    // final synthesized brief
  error        String?
  // Lock so two cron ticks don't race the same job
  lockedAt     DateTime?
  lockedBy     String?
  // House-keeping
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([state, updatedAt])
  @@index([userId])
}

// Singleton config row (id = "default") that the admin can toggle at runtime
// from the Admin Console.
//
//  proEnforcementEnabled = false  →  Pro features are unlocked for EVERYONE
//                                    (free users get full Pro experience,
//                                     no quota, no Pro-only locks).
//  proEnforcementEnabled = true   →  Free vs Pro distinction kicks in:
//                                    free users see basic generation,
//                                    capped at `freeDocsLimit` per month,
//                                    Pro-only doc types are locked.
model SystemConfig {
  id                    String   @id @default("default")
  proEnforcementEnabled Boolean  @default(false)
  freeDocsLimit         Int      @default(10)
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

// ── Live legal data ───────────────────────────────────────────────
// Case law and legislation pulled from external providers. Everything
// here is a CACHE, never a mirror: the judgment corpus is 30M+ documents
// billed per call, so we fetch on demand and keep what users actually
// open. Nothing is stored that we did not fetch for a real request.

// One Act from India Code (indiacode.nic.in), the official Government
// repository of every Central and State enactment. Free and public, so
// this table IS harvested in full — unlike judgments.
model ActRecord {
  id            String    @id @default(cuid())
  source        String    @default("indiacode")
  handle        String    @unique          // India Code DSpace handle
  shortTitle    String
  actNumber     String?
  actYear       Int?
  ministry      String?
  enactmentDate DateTime?
  jurisdiction  String    @default("central")  // central | <state>
  url           String
  repealed      Boolean   @default(false)
  firstSeenAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([actYear])
  @@index([shortTitle])
  @@index([jurisdiction])
}

// A judgment fetched from a provider and kept so the same document is
// never paid for twice. hitCount drives what is worth keeping if the
// cache ever needs trimming.
model CachedJudgment {
  id           String    @id @default(cuid())
  provider     String                        // indiankanoon | ecourts
  docId        String
  title        String
  court        String?
  bench        String?
  judgmentDate DateTime?
  citation     String?
  snippet      String?
  fullText     String?
  sourceUrl    String?
  fetchedAt    DateTime  @default(now())
  lastReadAt   DateTime  @default(now())
  hitCount     Int       @default(1)

  @@unique([provider, docId])
  @@index([court])
  @@index([judgmentDate])
}

// A case a user is following by CNR. Refreshed by the daily job so the
// next hearing date on their dashboard stays current without anyone
// having to look it up by hand.
model TrackedCase {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cnr           String                        // Case Number Record, the national id
  caseNumber    String?
  title         String?
  court         String?
  stage         String?
  nextHearing   DateTime?
  lastOrderDate DateTime?
  parties       String?
  raw           String?                       // provider payload, as returned
  refreshedAt   DateTime  @default(now())
  refreshError  String?
  createdAt     DateTime  @default(now())

  @@unique([userId, cnr])
  @@index([userId])
  @@index([nextHearing])
}

// One row per run of the daily sync. Doubles as the resume cursor: the
// job is bounded by wall-clock time so it fits a serverless invocation,
// and picks up next morning where it stopped.
model LegalSyncRun {
  id         String    @id @default(cuid())
  job        String                          // acts | cases | judgments
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  cursor     String?
  scanned    Int       @default(0)
  added      Int       @default(0)
  updated    Int       @default(0)
  error      String?

  @@index([job, startedAt])
}

// ── Institutions ──────────────────────────────────────────────────
// A law college (or firm) whose members get Pro without anyone adding
// them one at a time. Membership is decided by email domain: a student
// signing up with @ulc.ac.in is linked and granted access automatically.
// Adding 300 students by hand was the single thing blocking college
// adoption.
model Institution {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  // Comma-separated, lowercased, no "@" — e.g. "ulc.ac.in,bub.ernet.in".
  // A list because colleges routinely have more than one domain.
  emailDomains String
  kind         String    @default("college")   // college | firm | chamber
  plan         String    @default("pilot")     // pilot | paid | expired
  seats        Int       @default(0)           // 0 = unlimited
  startsAt     DateTime  @default(now())
  endsAt       DateTime?                       // null = no expiry
  contactName  String?
  contactEmail String?
  notes        String?
  // A short code a student can type to join, for colleges that issue no
  // student email and whose class list nobody has. The Moot Court
  // Society reads it out once; three hundred students onboard
  // themselves. Regenerating it cuts off anyone who has passed it on.
  joinCode     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  members  User[]
  invites  InstitutionInvite[]
  imports  StudentImport[]
  usage    ApiUsage[]
  invoices Invoice[]

  @@index([plan])
}

// A pre-authorised email. Lets a college onboard a class whose students
// use personal addresses, which is common — many Indian colleges do not
// issue student email at all.
model InstitutionInvite {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  email         String
  batch         String?                        // "BA LLB 2027" — for reporting
  claimedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@unique([institutionId, email])
  @@index([email])
}

// ── Cost tracking ─────────────────────────────────────────────────
// One row per billed upstream call. Without this there is no way to
// answer "what does a user cost", which is the number every pricing
// decision depends on. Cost is stored in paise as an integer: floating
// point money is a bug waiting to happen, and the rates are estimates
// anyway, so the unit needs to be exact even when the value is not.
model ApiUsage {
  id            String       @id @default(cuid())
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  provider  String                                // groq | indiankanoon | ecourts | indiacode
  operation String                                // draft | search | analyze | fulltext | case | sample | moot
  calls     Int      @default(1)
  tokens    Int?                                  // groq only
  costPaise Int      @default(0)                  // estimated
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([institutionId, createdAt])
  @@index([provider, createdAt])
  @@index([createdAt])
}

// ── Subscriptions ─────────────────────────────────────────────────
// Razorpay state. Separate from User.tier because tier is the *effective*
// answer (admin, promo, institution or payment can all grant it) while
// this records what was actually bought.
model Subscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan              String                        // monthly | yearly
  status            String    @default("created") // created | active | halted | cancelled | expired
  amountPaise       Int       @default(0)
  currency          String    @default("INR")

  razorpayOrderId   String?   @unique
  razorpayPaymentId String?
  razorpaySubId     String?   @unique
  razorpaySignature String?

  startsAt          DateTime?
  currentEnd        DateTime?                     // access runs until this
  cancelledAt       DateTime?
  lastPaymentAt     DateTime?
  failCount         Int       @default(0)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([currentEnd])
}

// A college asking to be set up, from the public /for-colleges page.
// Kept as its own thing rather than an inactive Institution so the
// institutions list stays a list of real customers, and so a request
// that goes nowhere leaves no half-built college behind.
model PilotRequest {
  id           String   @id @default(cuid())
  college      String
  contactName  String
  contactEmail String
  phone        String?
  role         String?                          // student | faculty | society | other
  students     String?                          // free text: "about 300"
  message      String?
  status       String   @default("new")         // new | contacted | converted | declined
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// An invoice raised against an institution.
//
// Stored rather than generated on the fly because the number has to be a
// sequence: an invoice with a number that changes, or repeats, is not an
// invoice a college's accounts department will accept, and under GST the
// series has to be continuous for the financial year.
//
// The amounts are frozen at issue. A price change next term must not
// silently rewrite an invoice a college has already paid.
model Invoice {
  id            String      @id @default(cuid())
  number        String      @unique                // LF/2026-27/0001
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  status        String      @default("proforma")   // proforma | issued | paid | cancelled
  description   String                             // "Annual licence, 300 seats"
  seats         Int         @default(0)
  unitPaise     Int         @default(0)
  amountPaise   Int         @default(0)            // seats x unit, before tax
  taxPercent    Int         @default(0)            // 18 once GST registration exists
  taxPaise      Int         @default(0)
  totalPaise    Int         @default(0)

  periodStart   DateTime?
  periodEnd     DateTime?
  issuedAt      DateTime?
  paidAt        DateTime?
  notes         String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId])
  @@index([status])
}

// One spreadsheet a college uploaded, and what it did.
//
// Kept because the import creates accounts, changes passwords and
// removes access — and when a college says "our third year lost access
// on Tuesday", the answer has to be a record rather than a guess.
//
// The file itself is NOT kept. It contains student names, emails and
// passwords in the clear; it is parsed in memory and discarded, and
// only the counts and the errors survive.
model StudentImport {
  id            String      @id @default(cuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  filename      String
  uploadedBy    String                            // email of whoever uploaded
  batch         String?

  rowsRead      Int         @default(0)
  created       Int         @default(0)           // new accounts
  relinked      Int         @default(0)           // existing users joined to this college
  updated       Int         @default(0)           // already members, details refreshed
  removed       Int         @default(0)           // dropped off the list
  skipped       Int         @default(0)           // bad or duplicate rows
  errors        Json?                             // row number -> what was wrong

  createdAt     DateTime    @default(now())

  @@index([institutionId, createdAt])
}
